# Clerk (dev instance keys: `clerk env pull --file .env.local`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex (written by `npx convex dev`; never set these two on Vercel — CONVEX_DEPLOY_KEY is the
# Vercel-side deploy var and `convex deploy` injects NEXT_PUBLIC_CONVEX_URL into the build)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# CONVEX_URL — Vercel only; deliberately NOT a key in this file, and do not add it to .env.local.
# `npx convex dev` picks which variable to write by matching the keys it parses out of .env.local
# against its own list, which holds CONVEX_URL and NEXT_PUBLIC_CONVEX_URL both: two matches and it
# warns "Found multiple ... so cannot update automatically" and writes neither — an empty value
# still counts, because it matches on keys.
# Nothing local needs it anyway: `pnpm dev` passes NEXT_PUBLIC_CONVEX_URL down to the eve dev
# server and lib/engine-env.ts falls back to it. On Vercel Production and Preview, set CONVEX_URL
# to that environment's Convex deployment URL — the eve services (agents/runtime, agents/builder)
# are separate Vercel services that see the project's env vars, and NEXT_PUBLIC_CONVEX_URL only
# ever exists inside the Next build. See docs/PROVISIONING.md.

# App-internal secrets (`openssl rand -base64 32`); ENGINE_SECRET must also be set on Convex (`npx convex env set ENGINE_SECRET …`)
ENGINE_SECRET=
CREDENTIALS_KEK=

# Public origin of this deployment (trigger URLs, OAuth callbacks, and the host `lib/eve.ts` points
# the Runtime agent client at: `${APP_ORIGIN}/eve/agents/runtime`)
APP_ORIGIN=http://localhost:3000

# Optional platform fallbacks (users normally bring their own connections inside the app)
RESEND_API_KEY=
# House model for the Runtime agent, through the Vercel AI Gateway. Only needed locally: on Vercel
# the deployment's OIDC token pays for the Gateway, and an org that picked its own AI connection on
# the Agent node never touches it. Without it, a local agent run dies at the model call with
# "AI Gateway received no credentials" — after auth and tool resolution, so everything else is
# still exercised.
AI_GATEWAY_API_KEY=
